# -----------------------------------------------------------------------------
# Product identity (safe defaults; override per environment)
# -----------------------------------------------------------------------------
PRODUCT_NAME=ReviewFlow
COMPANY_NAME=Example Company
PUBLIC_BASE_URL=http://localhost:8000
SUPPORT_EMAIL=support@example.test
PRIVACY_EMAIL=privacy@example.test
DEFAULT_FROM_EMAIL=ReviewFlow <noreply@example.test>

# Mobile build-time identity. Change before creating the Play Console app.
APP_NAME=ReviewFlow Merchant
APP_SLUG=reviewflow-merchant
ANDROID_PACKAGE=com.example.reviewflow
APP_SCHEME=reviewflow
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-real-environments
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
DATABASE_URL=postgresql://reviewflow:reviewflow@db:5432/reviewflow

# JWT / account lifecycle
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=14
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_HOURS=2
MERCHANT_APPROVAL_REQUIRED=true

# Email backend. Console is appropriate only for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Google review destination validation
GOOGLE_REVIEW_ALLOWED_HOSTS=g.page,search.google.com,www.google.com,maps.google.com,maps.app.goo.gl,goo.gl
GOOGLE_REVIEW_LINK_TIMEOUT_SECONDS=8

# LiteLLM OpenAI-compatible proxy
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=change-me
LITELLM_MODEL=review-assistant
LITELLM_TIMEOUT_SECONDS=20
LITELLM_MAX_CONCURRENCY=4
LITELLM_TEMPERATURE=0.25

# Upstream model server used by the bundled LiteLLM container.
# The default assumes an OpenAI-compatible local model endpoint.
MODEL_BASE_URL=http://host.docker.internal:8080/v1
MODEL_API_KEY=not-required
MODEL_NAME=local-model

# Public-flow protections
PUBLIC_THROTTLE_ANON=60/minute
GENERATION_THROTTLE_ANON=10/minute
MAX_GENERATIONS_PER_SESSION=2
MAX_COMMENT_LENGTH=1200
MAX_REVIEW_LENGTH=1500

# Caddy / deployment
APP_DOMAIN=localhost
CADDY_EMAIL=admin@example.test
POSTGRES_DB=reviewflow
POSTGRES_USER=reviewflow
POSTGRES_PASSWORD=reviewflow
IMAGE_TAG=local
